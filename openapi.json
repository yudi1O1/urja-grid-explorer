{
  "openapi": "3.0.3",
  "info": {
    "title": "Urja Meter API",
    "version": "1.0.0",
    "description": "A clean read-only API service over the legacy Urja Meter Ops portal."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Health check for the API service.",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/meters": {
      "get": {
        "summary": "Search Meters",
        "description": "Search and paginate meters from the Urja Meter Ops portal.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": ""
            },
            "description": "search text"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based upstream page number (20 records per page)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/{meterId}/location": {
      "get": {
        "summary": "Get Meter Location",
        "description": "Get the geographical location of a meter.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterLocationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/{meterId}/consumption": {
      "get": {
        "summary": "Get Meter Consumption",
        "description": "Get energy consumption readings for a meter.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meters/{meterId}": {
      "get": {
        "summary": "Get meter details and network hierarchy",
        "description": "Returns normalized nameplate fields and the seven-level distribution hierarchy.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,31}$"
            },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid meter identifier",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failure or unexpected payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/transformers": {
      "get": {
        "summary": "List distribution transformers",
        "description": "Returns a paginated list of distribution transformers.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based upstream page number (20 records per page)."
          }
        ],
        "responses": {
          "200": {
            "description": "Transformer page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream portal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meter": {
        "type": "object",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phaseType": {
            "type": "string",
            "example": "single"
          },
          "installStatus": {
            "type": "string",
            "example": "Decommissioned"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          }
        },
        "required": [
          "meterId",
          "serialNo",
          "make",
          "phaseType",
          "installStatus",
          "dtCode"
        ]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "example": 403
          },
          "page": {
            "type": "integer",
            "example": 1
          },
          "pageSize": {
            "type": "integer",
            "example": 20
          }
        },
        "required": [
          "total",
          "page",
          "pageSize"
        ]
      },
      "MeterSearchResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "MeterLocation": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "example": 26.938961002479868
          },
          "longitude": {
            "type": "number",
            "example": 75.83095696146852
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "MeterLocationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MeterLocation"
          }
        }
      },
      "ConsumptionReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "Timestamp exactly as received from upstream.",
            "example": "23/06/2026 23:30"
          },
          "kwh": {
            "type": "number",
            "example": 48438.74
          },
          "kvah": {
            "type": "number",
            "example": 52313.84
          },
          "voltR": {
            "type": "number",
            "example": 226
          }
        },
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "voltR"
        ]
      },
      "ConsumptionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_PAGE",
                "enum": [
                  "INVALID_PAGE",
                  "INVALID_QUERY",
                  "INVALID_METER_ID",
                  "UPSTREAM_ERROR",
                  "UPSTREAM_INVALID_RESPONSE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string",
                "example": "page must be a positive integer"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "MeterNameplate": {
        "type": "object",
        "required": [
          "meterId",
          "serialNo",
          "make",
          "phaseType",
          "installStatus",
          "installationType"
        ],
        "properties": {
          "meterId": {
            "type": "string"
          },
          "serialNo": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "phaseType": {
            "type": "string"
          },
          "installStatus": {
            "type": "string"
          },
          "installationType": {
            "type": "string"
          }
        }
      },
      "HierarchyItem": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Jaipur Zone 1"
          },
          "code": {
            "type": "string",
            "example": "Z-01"
          }
        }
      },
      "MeterHierarchy": {
        "type": "object",
        "required": [
          "zone",
          "circle",
          "division",
          "subdivision",
          "substation",
          "feeder",
          "dt"
        ],
        "properties": {
          "zone": {
            "$ref": "#/components/schemas/HierarchyItem"
          },
          "circle": {
            "$ref": "#/components/schemas/HierarchyItem"
          },
          "division": {
            "$ref": "#/components/schemas/HierarchyItem"
          },
          "subdivision": {
            "$ref": "#/components/schemas/HierarchyItem"
          },
          "substation": {
            "$ref": "#/components/schemas/HierarchyItem"
          },
          "feeder": {
            "$ref": "#/components/schemas/HierarchyItem"
          },
          "dt": {
            "$ref": "#/components/schemas/HierarchyItem"
          }
        }
      },
      "MeterDetailResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "nameplate",
              "hierarchy"
            ],
            "properties": {
              "nameplate": {
                "$ref": "#/components/schemas/MeterNameplate"
              },
              "hierarchy": {
                "$ref": "#/components/schemas/MeterHierarchy"
              }
            }
          }
        }
      },
      "Transformer": {
        "type": "object",
        "required": [
          "code",
          "name",
          "feederCode",
          "capacityKva"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "example": "Malviya Nagar DT 1"
          },
          "feederCode": {
            "type": "string",
            "example": "F-001"
          },
          "capacityKva": {
            "type": "number",
            "example": 100
          }
        }
      },
      "TransformerSearchResponse": {
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transformer"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      }
    }
  }
}
